  <property name="styleSheet">
   <string notr="true">QDialog {
    background: #0b1220;
}
QLabel {
    color: #d8e1ef;
}
QComboBox, QTextEdit, QPlainTextEdit {
    background: #111a2b;
    color: #edf2fb;
    border: 1px solid #31425e;
    border-radius: 10px;
    padding: 8px;
    selection-background-color: #375a9e;
}
QTextEdit:disabled, QPlainTextEdit:disabled {
    color: #aab7cb;
}
QComboBox {
    min-height: 34px;
    padding: 6px 12px;
    padding-right: 30px;
}
QComboBox::drop-down {
    width: 28px;
    border: none;
    background: #1a2740;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    subcontrol-origin: padding;
    subcontrol-position: top right;
}
QComboBox::down-arrow {
    image: url(:/assets/icons/chevron_down_light.svg);
    width: 12px;
    height: 8px;
}
QPushButton {
    min-height: 34px;
    border-radius: 10px;
    border: 1px solid #395178;
    background: #16233a;
    color: #edf2fb;
    padding: 0 14px;
}
QPushButton:hover {
    background: #1d2d49;
}
QPushButton:pressed {
    background: #25395b;
}
QPushButton#sendButton {
    background: #2e7cf6;
    border: 1px solid #4d93ff;
    color: white;
    font-weight: 600;
}
QPushButton#sendButton:hover {
    background: #3b88ff;
}
QScrollBar:vertical {
    background: #0c1320;
    width: 12px;
    margin: 2px;
    border-radius: 6px;
}
QScrollBar::handle:vertical {
    background: #5f7599;
    min-height: 32px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background: #7f98c0;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}
QScrollBar:horizontal {
    background: #0c1320;
    height: 12px;
    margin: 2px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal {
    background: #5f7599;
    min-width: 32px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal:hover {
    background: #7f98c0;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}</string>
