    <item>
     <widget class="QFrame" name="bottomControlFrame">
      <property name="styleSheet">
       <string notr="true">QFrame#bottomControlFrame{background:#1f2430;border:1px solid #2f3645;border-radius:8px;}
QPushButton,QToolButton{background:#2f3b52;color:#eef3ff;border:1px solid #465778;border-radius:6px;padding:3px 9px;font-weight:600;min-height:22px;}
QPushButton:hover,QToolButton:hover{background:#394661;}
QPushButton#startReceiveButton{background:#3a4963;border-color:#536788;}
QPushButton#logoutButton{background:#6a3a3a;border-color:#8a5252;}
QPushButton#startMeetingButton{background:#2e86de;border-color:#4b9aea;}
QPushButton#stopMeetingButton{background:#d64545;border-color:#e86b6b;}
QPushButton#startRecordButton{background:#2f6f45;border-color:#4e9366;}
QPushButton#stopRecordButton{background:#5c3b3b;border-color:#7e5353;}
QToolButton::menu-indicator{image:none;}
QFrame#ctrlSep1,QFrame#ctrlSep2{background:#3a4253;max-width:1px;min-width:1px;}
QFrame#beautyStrengthFrame{background:#1a2230;border:1px solid #334055;border-radius:6px;}
QLabel#beautyStrengthTitle,QLabel#beautyStrengthValueLabel{color:#9fb0cf;font-weight:600;}
QSlider#beautyStrengthSlider::groove:horizontal{height:4px;background:#2f3b52;border-radius:2px;}
QSlider#beautyStrengthSlider::handle:horizontal{width:12px;margin:-5px 0;border-radius:6px;background:#4b9aea;border:1px solid #6bb7ff;}
QFrame#deviceEdgeFrame{background:#1a2230;border:1px solid #334055;border-radius:6px;}
QComboBox{background:#232c3d;color:#e2e9f8;border:1px solid #425170;border-radius:4px;padding:2px 6px;min-height:22px;}
QLabel#deviceEdgeTitle{color:#9fb0cf;font-weight:600;}</string>
