   <property name="styleSheet">
    <string notr="true">QDockWidget{font-size:13px;}
QListWidget#roomUserList{background:#111722;border:1px solid #2f394d;border-radius:6px;color:#e6edf8;outline:none;}
QListWidget#roomUserList::item{padding:6px 6px;}
QListWidget#roomUserList::item:selected{background:#2b3850;border:1px solid #48608a;border-radius:4px;}
QTabWidget::pane{border:1px solid #2f394d;border-radius:6px;background:#1a2230;}
QTabBar::tab{background:#263146;color:#ced8eb;padding:5px 10px;min-width:0;border-top-left-radius:4px;border-top-right-radius:4px;}
QTabBar::tab:selected{background:#334260;color:#f3f7ff;}
QPlainTextEdit#roomEventLog,QPlainTextEdit#chatMessageLog{background:#111722;border:1px solid #2f394d;border-radius:6px;color:#d6deef;}
QTextEdit#chatInputEdit{background:#0f1622;border:1px solid #2f394d;border-radius:6px;color:#e7eefb;padding:4px 8px;}
QTextEdit#chatInputEdit:focus{border:1px solid #4b628c;}
QPushButton#sendChatButton{background:#344766;color:#f3f7ff;border:1px solid #4e648c;border-radius:6px;padding:4px 12px;}
QPushButton#sendChatButton:hover{background:#3b5275;}
QPushButton#sendChatButton:pressed{background:#2e425f;}</string>
   </property>
